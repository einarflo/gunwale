generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("CHALLENGER_DATABASE_URL")
}

model ai_cache {
  id             BigInt              @id @default(autoincrement())
  kind           String              @db.VarChar(32)
  cache_key      String              @unique(map: "cache_key") @db.VarChar(512)
  model          String?             @db.VarChar(64)
  prompt_version String?             @db.VarChar(16)
  prompt         Json?
  result         Json
  hit_count      Int                 @default(0)
  upvotes        Int                 @default(0)
  downvotes      Int                 @default(0)
  created_at     DateTime            @default(now()) @db.Timestamp(0)
  last_hit_at    DateTime?           @db.Timestamp(0)
  feedbacks      ai_cache_feedback[]

  @@index([created_at], map: "idx_created_at")
  @@index([kind], map: "idx_kind")
  @@index([last_hit_at], map: "idx_last_hit_at")
  @@index([model], map: "idx_model")
  @@index([prompt_version], map: "idx_prompt_version")
}

model ai_cache_feedback {
  id         BigInt   @id @default(autoincrement())
  cache_id   BigInt
  vote       Vote
  user_ref   String?  @db.VarChar(128)
  source     String?  @db.VarChar(64)
  created_at DateTime @default(now()) @db.Timestamp(0)
  cache      ai_cache @relation(fields: [cache_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_feedback_cache")

  @@index([cache_id], map: "idx_cache_id")
  @@index([created_at], map: "idx_created_at")
}

enum Vote {
  up
  down
}
