{
  "name": "challenger",
  "version": "0.1.0",
  "main": "src/index.ts",
  "scripts": {
    "prestart": "npm run build",
    "build": "tsc -p tsconfig.json",
    "start": "ts-node src/index.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "postinstall": "sh -c 'if [ -f prisma/schema.prisma ]; then npx prisma generate --schema prisma/schema.prisma; fi'"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "morgan": "^1.10.1",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.4",
    "prisma": "^6.15.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
