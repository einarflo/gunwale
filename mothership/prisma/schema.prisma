generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model game {
  id              Int     @id @unique(map: "game_id_uindex") @default(autoincrement())
  name            String  @db.VarChar(255)
  created_by      String? @db.VarChar(255)
  description     String? @db.VarChar(255)
  status          String? @db.VarChar(255)
  playthroughs    Int     @default(0)
  currentquestion String? @db.VarChar(250)
  starttime       String? @db.VarChar(250)
  deleted         String? @db.VarChar(100)
  isPublic        Int     @default(0)
  uuid            String  @db.VarChar(255)
  created_by_name String? @db.VarChar(255)
  created_at      String? @db.VarChar(250)
  updated_at      String? @db.VarChar(250)
}

model game_instance {
  id              Int     @id @unique(map: "game_instance_id_uindex") @default(autoincrement())
  game_id         String  @db.VarChar(255)
  game_pin        String  @db.VarChar(255)
  created_at      String? @db.VarChar(255)
  is_deleted      String? @db.VarChar(255)
  status          String? @db.VarChar(255)
  currentquestion Int?
  created_by      String? @db.VarChar(255)
  starttime       String? @db.VarChar(255)
  uuid            String? @db.VarChar(255)
}

model game_instance_answers {
  id                      Int     @id @unique(map: "game_instance_answers_id_uindex") @default(autoincrement())
  game_instance_id        String? @db.VarChar(255)
  game_instance_player_id String? @db.VarChar(255)
  game_question_id        String? @db.VarChar(255)
  game_id                 String? @db.VarChar(255)
  points                  String? @db.VarChar(255)
  alternative             String? @db.VarChar(255)
  correct                 String? @db.VarChar(255)
}

model game_instance_players {
  id               Int     @id @unique(map: "game_instance_players_id_uindex") @default(autoincrement())
  game_id          String  @db.VarChar(255)
  game_instance_id String  @db.VarChar(255)
  username         String  @db.VarChar(255)
  score            String  @db.VarChar(255)
  colour           String? @db.VarChar(255)
  lottery          String? @db.VarChar(255)
  spending         String? @db.VarChar(255)
}

model game_instance_upgrades {
  id                      Int     @id @unique(map: "game_instance_upgrades_id_uindex") @default(autoincrement())
  game_instance_id        String? @db.VarChar(255)
  game_instance_player_id String? @db.VarChar(255)
  game_id                 String? @db.VarChar(255)
  price                   String? @db.VarChar(255)
  level                   String? @db.VarChar(255)
  type                    String? @db.VarChar(255)
}

model game_question {
  id             Int     @id @unique(map: "game_question_id_uindex") @default(autoincrement())
  game_id        String  @db.VarChar(255)
  number_in_line String? @db.VarChar(255)
  status         String? @db.VarChar(255)
  score          String? @db.VarChar(255)
  text           String? @db.VarChar(1000)
  description    String? @db.VarChar(1000)
  alt1           String? @db.VarChar(1000)
  alt2           String? @db.VarChar(1000)
  alt3           String? @db.VarChar(1000)
  alt4           String? @db.VarChar(1000)
  correct        String? @db.VarChar(255)
  time           String? @db.VarChar(255)
  deleted        String? @db.VarChar(100)
  uuid           String? @db.VarChar(255)
}

model favourite_games {
  id      Int    @id @default(autoincrement())
  user_id String @db.VarChar(255)
  game_id String @db.VarChar(255)
}

model checkout_sessions {
  id                 BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  stripe_session_id  String       @unique(map: "uq_checkout_session_id") @db.VarChar(255)
  user_id            String
  stripe_customer_id String?      @db.VarChar(255)
  mode               String       @db.VarChar(64)
  price_id           String       @db.VarChar(255)
  status             String?      @db.VarChar(64)
  payment_status     String?      @db.VarChar(64)
  success_url        String?      @db.VarChar(2048)
  cancel_url         String?      @db.VarChar(2048)
  metadata           Json?
  created_at         DateTime     @default(now())
  completed_at       DateTime?
  user_billing       user_billing @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "fk_checkout_sessions_user")

  @@index([user_id, created_at], map: "idx_checkout_sessions_user_created")
}

model invoices {
  stripe_invoice_id      String         @id @db.VarChar(255)
  stripe_customer_id     String         @db.VarChar(255)
  stripe_subscription_id String?        @db.VarChar(255)
  status                 String?        @db.VarChar(64)
  amount_due             BigInt?
  amount_paid            BigInt?
  currency               String?        @db.VarChar(16)
  hosted_invoice_url     String?        @db.VarChar(2048)
  pdf                    String?        @db.VarChar(2048)
  period_start           DateTime?
  period_end             DateTime?
  created_at             DateTime       @default(now())
  subscriptions          subscriptions? @relation(fields: [stripe_subscription_id], references: [stripe_subscription_id], map: "fk_invoices_subscription")

  @@index([stripe_customer_id], map: "idx_invoices_customer")
  @@index([stripe_subscription_id], map: "idx_invoices_subscription")
}

model role_assignments_log {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    String
  action     String   @db.VarChar(64)
  reason     String?  @db.VarChar(255)
  context    Json?
  created_at DateTime @default(now())

  @@index([user_id, created_at], map: "idx_role_log_user_created")
}

model subscriptions {
  id                     BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  stripe_subscription_id String       @unique(map: "uq_subscriptions_stripe_subscription") @db.VarChar(255)
  user_id                String
  stripe_customer_id     String       @db.VarChar(255)
  status                 String       @db.VarChar(64)
  price_id               String       @db.VarChar(255)
  quantity               Int          @default(1)
  current_period_start   DateTime?
  current_period_end     DateTime?
  cancel_at              DateTime?
  canceled_at            DateTime?
  plan_snapshot          Json?
  is_active              Boolean      @default(false)
  created_at             DateTime     @default(now())
  updated_at             DateTime     @default(now())
  invoices               invoices[]
  user_billing           user_billing @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "fk_subscriptions_user_billing")

  @@index([stripe_customer_id], map: "idx_subscriptions_customer")
  @@index([user_id, is_active], map: "idx_subscriptions_user_active")
}

model user_billing {
  user_id            String              @id
  stripe_customer_id String              @unique(map: "uq_user_billing_stripe_customer") @db.VarChar(255)
  email              String?             @db.VarChar(255)
  default_currency   String?             @db.VarChar(16)
  created_at         DateTime            @default(now())
  updated_at         DateTime            @default(now())
  checkout_sessions  checkout_sessions[]
  subscriptions      subscriptions[]
}

model webhook_events {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  stripe_event_id String    @unique(map: "uq_webhook_events_stripe_event") @db.VarChar(255)
  type            String    @db.VarChar(128)
  received_at     DateTime  @default(now())
  processed_at    DateTime?
  status          String    @default("received") @db.VarChar(32)
  request_id      String?   @db.VarChar(255)
  payload         Json?

  @@index([status], map: "idx_webhook_events_status")
  @@index([type], map: "idx_webhook_events_type")
}

model game_tags {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  game_id    String   @db.VarChar(255)
  tag_id     Int      @db.UnsignedInt
  created_at DateTime @default(now()) @db.DateTime(0)
  tags       tags     @relation(fields: [tag_id], references: [id], onDelete: Cascade, map: "fk_game_tags_tag")

  @@unique([game_id, tag_id], map: "uq_game_tag")
  @@index([game_id], map: "idx_game_tags_game")
  @@index([tag_id], map: "idx_game_tags_tag")
}

model tags {
  id          Int         @id @default(autoincrement()) @db.UnsignedInt
  name        String      @unique(map: "uq_tags_name") @db.VarChar(64)
  slug        String      @unique(map: "uq_tags_slug") @db.VarChar(64)
  description String?     @db.VarChar(255)
  created_at  DateTime    @default(now()) @db.DateTime(0)
  updated_at  DateTime    @default(now()) @db.DateTime(0)
  game_tags   game_tags[]
}
